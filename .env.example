# OpenRouter — used purely as a model router for every LLM call (no
# OpenRouter web_search plugin; Exa is orchestrated client-side in
# src/benchmark/benchmark_text_qa.py).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Exa — required. The benchmark exposes an `exa_search(query)` function
# tool to every model; when the model calls it, the benchmark POSTs
# directly to https://api.exa.ai/search. Hard caps: 3 rounds, 10 URLs
# per question.
# Get a key at https://dashboard.exa.ai
EXA_API_KEY=...
